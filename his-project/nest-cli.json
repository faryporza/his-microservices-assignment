{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/opd-bc/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/opd-bc/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/opd-bc",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "emr-bc": {
      "type": "application",
      "root": "apps/emr-bc",
      "entryFile": "main",
      "sourceRoot": "apps/emr-bc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/emr-bc/tsconfig.app.json"
      }
    },
    "finance-bc": {
      "type": "application",
      "root": "apps/finance-bc",
      "entryFile": "main",
      "sourceRoot": "apps/finance-bc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/finance-bc/tsconfig.app.json"
      }
    },
    "opd-bc": {
      "type": "application",
      "root": "apps/opd-bc",
      "entryFile": "main",
      "sourceRoot": "apps/opd-bc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/opd-bc/tsconfig.app.json"
      }
    }
  }
}
