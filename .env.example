OPD_PORT=3000
EMR_PORT=3001
FINANCE_PORT=3002
IAM_PORT=3003

SERVICE_VERSION=0.0.1
LOG_LEVEL=debug

OPD_RABBITMQ_QUEUE=opd.events
EMR_RABBITMQ_QUEUE=emr.events
FINANCE_RABBITMQ_QUEUE=finance.events
IAM_RABBITMQ_QUEUE=iam.events

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

OPD_DATABASE=opd_db
EMR_DATABASE=emr_db
FINANCE_DATABASE=finance_db
IAM_DATABASE=iam_db

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=his.events
RABBITMQ_DLX_EXCHANGE=his.events.dlx

API_PREFIX=api/v1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
