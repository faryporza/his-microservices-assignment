{
  "info": {
    "name": "HIS Microservices — repeatable business flow",
    "description": "Repeatable OPD → EMR → Finance flow with unique patient data, eventual-consistency retries, and state assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "opd_base_url", "value": "http://localhost:3000" },
    { "key": "emr_base_url", "value": "http://localhost:3001" },
    { "key": "finance_base_url", "value": "http://localhost:3002" },
    { "key": "patient_id", "value": "" },
    { "key": "visit_id", "value": "" },
    { "key": "record_id", "value": "" },
    { "key": "invoice_id", "value": "" },
    { "key": "retry_count", "value": "0" }
  ],
  "item": [
    {
      "name": "1. Register unique patient",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('test_suffix', suffix);",
              "pm.collectionVariables.set('retry_count', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('patient created', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  const patientId = body.data ? body.data.id : body.id;",
              "  pm.expect(patientId).to.be.a('string');",
              "  if (body.status && body.status.code) {",
              "    pm.expect(body.status.code).to.eql(201000);",
              "  }",
              "  if (body.data && body.data.type) {",
              "    pm.expect(body.data.type).to.eql('patients');",
              "  }",
              "  pm.collectionVariables.set('patient_id', patientId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hn\": \"HN-POSTMAN-{{test_suffix}}\",\n  \"first_name\": \"Somchai\",\n  \"last_name\": \"Jaidee\",\n  \"id_card\": \"ID-POSTMAN-{{test_suffix}}\"\n}"
        },
        "url": "{{opd_base_url}}/patients"
      }
    },
    {
      "name": "2. Open visit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('visit opened', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  const visitId = body.data ? body.data.id : body.id;",
              "  const status = body.data && body.data.attributes ? body.data.attributes.status : body.status;",
              "  pm.expect(status).to.eql('OPEN');",
              "  if (body.status && body.status.code) {",
              "    pm.expect(body.status.code).to.eql(201000);",
              "  }",
              "  if (body.data && body.data.type) {",
              "    pm.expect(body.data.type).to.eql('visits');",
              "  }",
              "  pm.collectionVariables.set('visit_id', visitId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient_id\": \"{{patient_id}}\"\n}"
        },
        "url": "{{opd_base_url}}/visits"
      }
    },
    {
      "name": "3. Wait for medical record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const maxRetries = 20;",
              "const body = pm.response.json();",
              "const records = body && Array.isArray(body.data) ? body.data : (Array.isArray(body) ? body : []);",
              "if (pm.response.code === 200 && records.length > 0) {",
              "  pm.test('waiting record created', function () {",
              "    const record = records[0];",
              "    const status = record.attributes ? record.attributes.status : record.status;",
              "    pm.expect(status).to.eql('WAITING');",
              "  });",
              "  const recordId = records[0].id;",
              "  pm.collectionVariables.set('record_id', recordId);",
              "  pm.collectionVariables.set('retry_count', '0');",
              "} else {",
              "  const retryCount = Number(pm.collectionVariables.get('retry_count') || '0') + 1;",
              "  pm.collectionVariables.set('retry_count', String(retryCount));",
              "  pm.test('record endpoint is retryable', function () { pm.expect([200, 404]).to.include(pm.response.code); });",
              "  if (retryCount < maxRetries) pm.execution.setNextRequest('3. Wait for medical record');",
              "  else pm.expect.fail('Medical record was not created in time');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{emr_base_url}}/records/visit/{{visit_id}}"
      }
    },
    {
      "name": "4. Complete treatment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('treatment completed', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  const status = body.data && body.data.attributes ? body.data.attributes.status : body.status;",
              "  pm.expect(status).to.eql('COMPLETED');",
              "  if (body.status && body.status.code) {",
              "    pm.expect(body.status.code).to.eql(200000);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor_id\": \"doctor-001\",\n  \"diagnosis\": \"Influenza\",\n  \"treatment_note\": \"Rest and fluids\",\n  \"treatment_cost\": 1500,\n  \"status\": \"COMPLETED\"\n}"
        },
        "url": "{{emr_base_url}}/records/{{record_id}}"
      }
    },
    {
      "name": "5. Wait for pending invoice",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const maxRetries = 20;",
              "const body = pm.response.json();",
              "const invoices = body && Array.isArray(body.data) ? body.data : (Array.isArray(body) ? body : []);",
              "if (pm.response.code === 200 && invoices.length > 0) {",
              "  pm.test('pending invoice created', function () {",
              "    const invoice = invoices[0];",
              "    const status = invoice.attributes ? invoice.attributes.status : invoice.status;",
              "    pm.expect(status).to.eql('PENDING');",
              "  });",
              "  const invoiceId = invoices[0].id;",
              "  pm.collectionVariables.set('invoice_id', invoiceId);",
              "  pm.collectionVariables.set('retry_count', '0');",
              "} else {",
              "  const retryCount = Number(pm.collectionVariables.get('retry_count') || '0') + 1;",
              "  pm.collectionVariables.set('retry_count', String(retryCount));",
              "  pm.test('invoice endpoint is retryable', function () { pm.expect([200, 404]).to.include(pm.response.code); });",
              "  if (retryCount < maxRetries) pm.execution.setNextRequest('5. Wait for pending invoice');",
              "  else pm.expect.fail('Invoice was not created in time');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{finance_base_url}}/invoices/{{visit_id}}"
      }
    },
    {
      "name": "6. Pay invoice",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('invoice paid', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  const status = body.data && body.data.attributes ? body.data.attributes.status : body.status;",
              "  const paidAt = body.data && body.data.attributes ? body.data.attributes.paid_at : body.paid_at;",
              "  pm.expect(status).to.eql('PAID');",
              "  pm.expect(paidAt).not.to.eql(null);",
              "  if (body.status && body.status.code) {",
              "    pm.expect(body.status.code).to.eql(200000);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PAID\"\n}"
        },
        "url": "{{finance_base_url}}/invoices/{{invoice_id}}/pay"
      }
    },
    {
      "name": "7. Wait for closed visit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const maxRetries = 20;",
              "const body = pm.response.json();",
              "const status = body && body.data && body.data.attributes ? body.data.attributes.status : (body ? body.status : undefined);",
              "if (pm.response.code === 200 && status === 'CLOSED') {",
              "  pm.test('visit closed', function () {",
              "    pm.expect(status).to.eql('CLOSED');",
              "    if (body.status && body.status.code) {",
              "      pm.expect(body.status.code).to.eql(200000);",
              "    }",
              "  });",
              "  pm.collectionVariables.set('retry_count', '0');",
              "} else {",
              "  const retryCount = Number(pm.collectionVariables.get('retry_count') || '0') + 1;",
              "  pm.collectionVariables.set('retry_count', String(retryCount));",
              "  pm.test('visit endpoint is retryable', function () { pm.expect(pm.response.code).to.eql(200); });",
              "  if (retryCount < maxRetries) pm.execution.setNextRequest('7. Wait for closed visit');",
              "  else pm.expect.fail('Visit was not closed in time');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{opd_base_url}}/visits/{{visit_id}}"
      }
    }
  ]
}
